NODE_ENV=development
PORT=3003
NOTIFICATION_RATE_LIMIT=10
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5436/notification_service?schema=public
REDIS_URL=redis://127.0.0.1:6383
EMAIL_MODE=log
# Set EMAIL_MODE=smtp and configure these for real email delivery.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=notifications@example.com
LOG_LEVEL=info
TRUST_PROXY=false
