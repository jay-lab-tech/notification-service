NODE_ENV=development
PORT=3003
NOTIFICATION_RATE_LIMIT=10
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5436/notification_service?schema=public
REDIS_URL=redis://127.0.0.1:6383
EMAIL_MODE=log
# Set EMAIL_MODE=smtp and configure these for real email delivery.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=notifications@example.com
# Optional FCM HTTP v1 provider; set all three values to enable PUSH.
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# Optional Twilio provider; set all three values to enable SMS.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+15551234567
# Optional public HTTPS endpoint to receive delivery receipts and set DELIVERED/FAILED status.
# TWILIO_STATUS_CALLBACK_URL=https://notifications.example.com/api/providers/twilio/status
# Optional signed webhook provider. Allow only endpoint hostnames you control.
# WEBHOOK_ALLOWED_HOSTS=hooks.example.com,api.example.com
# WEBHOOK_SIGNING_SECRET=replace-with-a-random-secret-at-least-32-characters
LOG_LEVEL=info
TRUST_PROXY=false
