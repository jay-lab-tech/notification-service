{
  "name": "notification-service",
  "version": "0.1.0",
  "private": true,
  "description": "Queue-based multi-channel notification service.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "api-key:create": "tsx scripts/create-api-key.ts",
    "api-key:list": "tsx scripts/list-api-keys.ts",
    "api-key:revoke": "tsx scripts/revoke-api-key.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bullmq": "^5.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "handlebars": "^4.7.10",
    "helmet": "^8.0.0",
    "ioredis": "^5.0.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.16.0",
    "twilio": "^6.1.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "prisma": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "mysql2": "3.23.1"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true,
    "msgpackr-extract": true
  }
}
